# Static file server inside the container. Traefik in front handles HTTPS and basic auth (D9).
{
	admin off
	auto_https off
}

:8080 {
	root * /srv
	encode zstd gzip

	# Vite fingerprints asset names, so they can be cached forever.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	# index.html must be revalidated, or a deploy won't show up.
	@html path / /index.html
	header @html Cache-Control "no-cache"

	# Single-page app: unknown paths (e.g. /ab-testing) serve index.html and React routes them.
	try_files {path} /index.html
	file_server
}
